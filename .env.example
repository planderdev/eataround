# Supabase(Postgres) 연결 문자열
# Supabase 대시보드 > Connect > Transaction pooler (포트 6543) 값을 사용합니다.
# 값이 없으면 화면은 lib/data.ts 샘플 데이터로 동작합니다.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# "false"로 두면 로그인 보호(/me, /checkout, /b2b/quote)와 실제 API를 사용합니다.
NEXT_PUBLIC_USE_MOCK=true
